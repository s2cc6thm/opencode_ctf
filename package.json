{
  "name": "opencode-ctf-toggle",
  "version": "1.1.0",
  "description": "OpenCode CTF mode toggle with a persistent engagement ledger, automatic flag capture, and a TUI status badge.",
  "type": "module",
  "exports": {
    "./server": {
      "import": "./index.js"
    },
    "./tui": {
      "import": "./tui.js"
    }
  },
  "files": [
    "index.js",
    "tui.js",
    "ctf-toggle-prompt.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check tui.js",
    "pack:dry-run": "npm pack --dry-run"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ctf",
    "security",
    "tui",
    "ledger"
  ],
  "dependencies": {
    "@opentui/solid": ">=0.4.0 <0.6.0",
    "solid-js": "1.9.12",
    "zod": "^4.1.8"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.14.0"
  },
  "engines": {
    "opencode": ">=1.18.0"
  },
  "license": "MIT",
  "author": "s2cc6thm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s2cc6thm/opencode_ctf.git"
  },
  "bugs": {
    "url": "https://github.com/s2cc6thm/opencode_ctf/issues"
  },
  "homepage": "https://github.com/s2cc6thm/opencode_ctf#readme",
  "publishConfig": {
    "access": "public"
  }
